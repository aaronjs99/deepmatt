# Project Specific
# Results - Ignore all generated plots and logs, but keep the directory structure
results/**/*.png
results/**/*.gif
results/**/*.csv
results/**/*.log
# Keep READMEs in results if they exist to preserve folder structure
!results/**/README.md

# Models - Ignore trained model weights (large binaries)
models/*.zip
models/*.pth
models/*.pt
models/*.h5

# Data - Ignore large datasets
data/*.csv
data/*.json
data/*.npy
data/*.npz
# Keep READMEs
!data/README.md

# Paper build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.bbl
paper/*.blg

# TensorBoard logs
*_tensorboard/
tensorboard/
logs/
